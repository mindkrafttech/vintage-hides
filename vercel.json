{
  "version": 2,
  "outputDirectory": ".",
  "crons": [
    { "path": "/api/cron", "schedule": "0 2 * * *" }
  ],
  "buildCommand": "",
  "installCommand": "npm install",
  "routes": [
    { "src": "/api/admin/upload",            "dest": "/api/admin/products.js" },
    { "src": "/api/admin/products(.*)",      "dest": "/api/admin/products.js" },
    { "src": "/api/admin/analytics(.*)",     "dest": "/api/admin/store.js" },
    { "src": "/api/admin/orders(.*)",        "dest": "/api/admin/orders.js" },
    { "src": "/api/admin/store(.*)",         "dest": "/api/admin/store.js" },
    { "src": "/api/admin/customers(.*)",     "dest": "/api/admin/store.js?section=customers" },
    { "src": "/api/admin/reviews(.*)",       "dest": "/api/admin/store.js?section=reviews" },
    { "src": "/api/admin/affiliates(.*)",    "dest": "/api/admin/store.js?section=affiliates" },
    { "src": "/api/admin/coupons(.*)",       "dest": "/api/admin/store.js?section=coupons" },
    { "src": "/api/admin/settings(.*)",      "dest": "/api/admin/store.js?section=settings" },
    { "src": "/api/admin/payouts(.*)",       "dest": "/api/admin/store.js?section=payouts" },
    { "src": "/api/admin/transactions(.*)",  "dest": "/api/admin/store.js?section=transactions" },
    { "src": "/api/admin/auth(.*)",          "dest": "/api/admin/auth.js" },
    { "src": "/api/reviews(.*)",             "dest": "/api/reviews.js" },
    { "src": "/api/upload(.*)",              "dest": "/api/reviews.js" },
    { "src": "/api/cron",                    "dest": "/api/cron.js" },
    { "src": "/api/orders(.*)",              "dest": "/api/orders.js" },
    { "src": "/api/affiliate/kyc(.*)",       "dest": "/api/affiliate/kyc.js" },
    { "src": "/api/affiliate(.*)",           "dest": "/api/affiliate.js" },
    { "src": "/api/account(.*)",             "dest": "/api/account.js" },
    { "src": "/api/public(.*)",              "dest": "/api/public.js" },
    { "src": "/api/preorder(.*)",            "dest": "/api/preorder.js" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/admin/", "dest": "/admin/index.html" },
    { "src": "/admin/analytics", "dest": "/admin/analytics.html" },
    { "src": "/admin/dashboard", "dest": "/admin/dashboard.html" },
    { "src": "/admin/products", "dest": "/admin/products.html" },
    { "src": "/admin/orders", "dest": "/admin/orders.html" },
    { "src": "/admin/customers", "dest": "/admin/customers.html" },
    { "src": "/admin/reviews", "dest": "/admin/reviews.html" },
    { "src": "/admin/affiliates", "dest": "/admin/affiliates.html" },
    { "src": "/admin/kyc",        "dest": "/admin/kyc.html" },
    { "src": "/admin/inventory", "dest": "/admin/inventory.html" },
    { "src": "/admin/coupons", "dest": "/admin/coupons.html" },
    { "src": "/admin/settings", "dest": "/admin/settings.html" },
    { "src": "/account", "dest": "/account.html" },
    { "src": "/order-success", "dest": "/order-success.html" },
    { "src": "/order-tracking", "dest": "/order-tracking.html" },
    { "src": "/pre-order-success", "dest": "/pre-order-success.html" },
    { "src": "/affiliate", "dest": "/Affiliate.html" },
    { "src": "/craftsmanship", "dest": "/craftsmanship.html" },
    { "src": "/journal", "dest": "/journal.html" },
    { "src": "/products/(.*)", "dest": "/product page.html?slug=$1" },
    { "src": "/", "dest": "/homepage.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    }
  ]
}
